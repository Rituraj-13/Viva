# ─────────────────────────────────────────────────────────────
# Viva — environment template
# Copy to web/.env.local for the app, or bakeoff/.env for the bake-off.
# Never commit the filled copy.
# ─────────────────────────────────────────────────────────────

# Database (Neon free tier). Leave the placeholder to use web/.data/sessions.json locally.
# The app creates the viva_sessions table on the first query.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional local file-store directory when DATABASE_URL is absent.
# VIVA_DATA_DIR=.data

# LLM — Groq is primary after the bake-off; Google is the automatic fallback.
AI_PROVIDER=groq                   # groq | google | anthropic
GROQ_API_KEY=                      # free: https://console.groq.com/keys
GOOGLE_GENERATIVE_AI_API_KEY=      # free: https://aistudio.google.com/apikey
MODEL_FALLBACK=openai/gpt-oss-120b # Groq model for exam design
MODEL_GRADING=openai/gpt-oss-20b   # faster Groq model for answer grading
MODEL_SMART=gemini-3.8-flash       # Google model for exam design
MODEL_FAST=gemini-3.8-flash        # Google model for answer grading

# LLM latency guardrails.
GROQ_TIMEOUT_MS=10000              # per-request Groq timeout
GROQ_REASONING_EFFORT=low          # none | default | low | medium | high
LLM_DEADLINE_MS=20000              # total budget across provider attempts

# Optional reserve. Disabled unless ALLOW_CLAUDE_FALLBACK=true.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ALLOW_CLAUDE_FALLBACK=false

# GitHub (optional; raises 60 req/hr to 5,000)
GITHUB_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_SESSIONS_PER_DAY=20
MAX_LIVE_SESSIONS_PER_DAY=20
MAX_TURNS_PER_HOUR=60

# Bake-off only (comma-separated: google,groq,anthropic)
BAKEOFF_PROVIDERS=google,groq

# Showcase proof assets (optional). The UI uses honest fallbacks when unset.
DEMO_VIDEO_URL=                    # e.g. https://youtu.be/... — makes the landing say “2-min demo”
FEATURED_REPORT_SLUG=              # slug of a finished live /r/<slug> report
FLOW_USAGE_CARD_URL=               # public image URL for the Wispr Flow usage card
FLOW_WORDS_DICTATED=               # optional stat, e.g. 12,400
FLOW_TIME_SAVED=                   # optional stat, e.g. 3h 20m
