# ─────────────────────────────────────────────────────────────
# Viva — environment template
# Copy to web/.env.local for the app, or bakeoff/.env for the bake-off.
# Never commit the filled copy.
# ─────────────────────────────────────────────────────────────

# Database (Neon free tier). Leave the placeholder to use web/.data/sessions.json locally.
# The app creates the viva_sessions table on the first query.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional local file-store directory when DATABASE_URL is absent.
# VIVA_DATA_DIR=.data

# LLM — Groq is primary after the bake-off; Google is the automatic fallback.
AI_PROVIDER=groq                   # groq | google | anthropic
GROQ_API_KEY=                      # free: https://console.groq.com/keys
GOOGLE_GENERATIVE_AI_API_KEY=      # free: https://aistudio.google.com/apikey
MODEL_FALLBACK=openai/gpt-oss-120b # Groq model
MODEL_SMART=gemini-3.8-flash       # Google model

# Optional reserve. Disabled unless ALLOW_CLAUDE_FALLBACK=true.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ALLOW_CLAUDE_FALLBACK=false

# GitHub (optional; raises 60 req/hr to 5,000)
GITHUB_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_SESSIONS_PER_DAY=10
MAX_LIVE_SESSIONS_PER_DAY=20
MAX_TURNS_PER_HOUR=60

# Bake-off only (comma-separated: google,groq,anthropic)
BAKEOFF_PROVIDERS=google,groq
